# Rust build artifacts (the "node_modules" of a Cargo project — rebuilt on
# checkout with `cargo build --release`).
/target/

# Machine-local config, in case one is ever created at the repo root. The real
# store lives at ~/.config/brain/config.json; see config.example.json.
/config.json

# Per-branch diff-review decision logs / review comments (personal, local-only).
# Currently only ignored via a machine-global gitignore; pin it here so this
# public repo never accidentally commits it on a machine without that global.
/.difit/

# macOS.
.DS_Store

# Agent dev-skills materialized from skills-lock.json (the "node_modules" of the
# `skills` CLI). Pinned in skills-lock.json (committed); restore with
# `skills experimental_install`. Not committed — machine/agent-local.
/.agents/
/.windsurf/
/.claude/skills/
